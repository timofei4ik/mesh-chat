# Dedicated call signaling. Chat workers use the same Redis stream producer.
MESH_CALL_SIGNALING_ENABLED=1
MESH_CALL_SIGNALING_STREAM_MAXLEN=100000
MESH_CALL_SIGNALING_HEARTBEAT_TTL_SECONDS=15
MESH_CALL_SIGNALING_ACTIVE_CALL_TTL_SECONDS=86400
MESH_CALL_SIGNALING_HOST=127.0.0.1
MESH_CALL_SIGNALING_PORT_BASE=8781

# The existing TURN shared secret remains outside Git in turn.env.
# MESH_TURN_URLS=turn:meshchat-losa.ru:3478?transport=udp,turn:meshchat-losa.ru:3478?transport=tcp
# MESH_TURN_SHARED_SECRET=replace-me
# Optional LiveKit SFU. Keep disabled until compatible clients are deployed.
MESH_CALL_SFU_ENABLED=0
# MESH_CALL_SFU_URL=wss://sfu.example.com
# MESH_CALL_SFU_API_KEY=replace-me
# MESH_CALL_SFU_API_SECRET=replace-me
MESH_CALL_SFU_TOKEN_TTL_SECONDS=300
MESH_CALL_SFU_REQUIRE_E2EE=1
