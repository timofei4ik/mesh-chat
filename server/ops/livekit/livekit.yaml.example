# Audio-only SFU for MeshChat group calls. Replace both key placeholders.
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
redis:
  address: 127.0.0.1:6379
keys:
  replace-livekit-api-key: replace-livekit-api-secret
room:
  auto_create: true
  empty_timeout: 300
  departure_timeout: 20
logging:
  level: info
