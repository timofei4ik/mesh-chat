global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/meshchat-alerts.yml

scrape_configs:
  - job_name: meshchat
    static_configs:
      - targets: ["127.0.0.1:8780"]
  - job_name: meshchat-call-signaling
    static_configs:
      - targets: ["127.0.0.1:8781", "127.0.0.1:8782"]
