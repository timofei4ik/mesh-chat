[Unit]
Description=MeshChat relay worker %i
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/mesh_messenger
EnvironmentFile=-/etc/mesh-messenger/server.env
EnvironmentFile=-/etc/mesh-messenger/meshpro.env
EnvironmentFile=-/etc/mesh-messenger/push.env
EnvironmentFile=/etc/mesh-messenger/media.env
EnvironmentFile=/etc/mesh-messenger/postgres.env
EnvironmentFile=/etc/mesh-messenger/turn.env
EnvironmentFile=/etc/mesh-messenger/call-signaling.env
Environment=MESH_WORKER_INDEX=%i
Environment=MESH_SERVER_HOST=127.0.0.1
Environment=MESH_SERVER_PORT_BASE=8870
Environment=MESH_SERVER_REUSE_PORT=0
ExecStart=/root/mesh_messenger/.venv/bin/python -m server.server
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
